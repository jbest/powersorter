{
    "versions": {
        "config_format": "3.0"
    },
    "collection": {
        "name": "WBU",
        "prefix": "WBU-V-",
        "catalog_number_regex": "(?P<catNum>(?P<instID>WBU-V-)(?P<numerical>\\d+))",
        "web_base": "/corral-repl/projects/TORCH/web/WBU",
        "url_base": "https://web.corral.tacc.utexas.edu/torch/"
    },
    "files": {
        "folder_increment": 1000,
        "number_pad": 5,
        "log_directory_path": "/corral-repl/projects/TORCH/archive/WBU/logs/",
        "output_base_path": "/corral-repl/projects/TORCH/",
        "input_path": "/corral-repl/projects/TORCH/staging/WBU/ready_to_sort"
    },
    "file_types": {
        "web_jpg": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(\\.)(?P<ext>jpg|jpeg)",
            "output_sub_path": "web/WBU/"
        },
        "web_jpg_med": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(_)(?P<size>med)(\\.)(?P<ext>jpg|jpeg)",
            "output_sub_path": "web/WBU/"
        },
        "web_jpg_thumb": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(_)(?P<size>thumb)(\\.)(?P<ext>jpg|jpeg)",
            "output_sub_path": "web/WBU/"
        },
        "archive_dng": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(\\.)(?P<ext>dng)",
            "output_sub_path": "archive/WBU/"
        },
        "ocr": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(_ocr)(\\.)(?P<ext>txt|json)",
            "output_sub_path": "web/WBU/"
        }
    }
}
