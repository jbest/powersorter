{
    "versions": {
        "config_format": "3.0"
    },
    "collection": {
        "name": "SAT",
        "prefix": "SAT",
        "catalog_number_regex": "(?P<catNum>(?P<instID>SAT)(-(?P<collID>XX)-)*(?P<numerical>\\d+))",
        "web_base": "/corral-repl/projects/TORCH/web/",
        "url_base": "https://web.corral.tacc.utexas.edu/torch/"
    },
    "files": {
        "folder_increment": 1000,
        "number_pad": 7,
        "log_directory_path": "/corral-repl/projects/TORCH/archive/SAT/logs/",
        "output_base_path": "/corral-repl/projects/TORCH/",
        "input_path": "/corral-repl/projects/TORCH/staging/SAT/ready_to_sort"
    },
    "file_types": {
        "web_jpg": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(\\.)(?i)(?P<ext>jpg|jpeg)",
            "output_sub_path": "web/SAT/"
        },
        "web_jpg_med": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(_)(?P<size>med)(\\.)(?i)(?P<ext>jpg|jpeg)",
            "output_sub_path": "web/SAT/"
        },
        "web_jpg_thumb": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(_)(?P<size>thumb)(\\.)(?i)(?P<ext>jpg|jpeg)",
            "output_sub_path": "web/SAT/"
        },
        "archive_dng": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(\\.)(?i)(?P<ext>dng)",
            "output_sub_path": "archive/SAT/"
        },
        "ocr": {
            "file_regex": "(_(?P<suffix>[a-z]|[0-9]))*(_ocr)(\\.)(?i)(?P<ext>txt|json)",
            "output_sub_path": "web/SAT/"
        }
    }
}
