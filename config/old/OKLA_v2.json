{
    "collection": {
        "name": "OKLA",
        "prefix": "OKLA"
     },
    "files": {
        "folder_increment": 1000,
        "number_pad": 7,
        "log_directory_path": "/corral-repl/projects/TORCH/archive/OKLA/logs/",
        "output_base_path": "/corral-repl/projects/TORCH/",
        "web_base_path": "/corral-repl/projects/TORCH/web/OKLA/",
        "archive_base_path": "/corral-repl/projects/TORCH/archive/OKLA/",
        "input_path": "/corral-repl/projects/TORCH/staging/OKLA/17jun/OK/"
    },
    "file_types": {
        "web_jpg": {
            "regex": "(?P<catalog_number>(?P<prefix>OKLA)(?P<numerical>\\d+))(?P<suffix>_[A-Z|a-z|0-9])?(\\.)(?i)(?P<ext>jpg|jpeg)",
            "output_sub_path": "web/OKLA/"
        },
        "web_jpg_med": {
            "regex": "(?P<catalog_number>(?P<prefix>OKLA)(?P<numerical>\\d+))(?P<suffix>_[A-Z|a-z|0-9])?(?P<delimiter>_)(?P<size>med)(\\.)(?P<ext>.+)",
            "output_sub_path": "web/OKLA/"
        },
        "web_jpg_thumb": {
            "regex": "(?P<catalog_number>(?P<prefix>OKLA)(?P<numerical>\\d+))(?P<suffix>_[A-Z|a-z|0-9])?(?P<delimiter>_)(?P<size>thumb)(\\.)(?P<ext>.+)",
            "output_sub_path": "web/OKLA/"
        },        
        "archive_dng": {
            "regex": "(?P<catalog_number>(?P<prefix>OKLA)(?P<numerical>\\d+))(?P<suffix>_[A-Z|a-z|0-9])?(\\.)(?i)(?P<ext>DNG)",
            "output_sub_path": "archive/OKLA/"
        },
        "ocr": {
            "regex": "(?P<catalog_number>(?P<prefix>OKLA)(?P<numerical>\\d+))(?P<suffix>_[A-Z|a-z|0-9])?(?P<delimiter>_)(?P<ocr>ocr)(\\.)(?P<ext>.+)",
            "output_sub_path": "web/OKLA/"
        }
    }
}
